# ─── Supabase ──────────────────────────────────────────────
# Tableau de bord Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé publique ("anon" ou "publishable"). Elle sert UNIQUEMENT à écouter les
# signaux de rafraîchissement en temps réel : la base est fermée à cette clé.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète ("service_role" ou "secret"). Ne JAMAIS la préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Accès famille ─────────────────────────────────────────
# Le code à saisir une seule fois sur chaque iPhone.
# Le changer déconnecte tous les appareils.
FAMILY_CODE=choisissez-un-code
# Chaîne aléatoire longue servant à signer les sessions.
# Générer avec : openssl rand -base64 32
SESSION_SECRET=

# ─── Notifications push (VAPID) ────────────────────────────
# Générer avec : npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Adresse de contact transmise aux services de push (Apple, Google…)
VAPID_SUBJECT=mailto:vous@example.com
